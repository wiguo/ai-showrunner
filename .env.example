# Qwen Cloud (Model Studio international) API key — get one at home.qwencloud.com/api-keys
# Pay-as-you-go keys (sk-...) use dashscope-intl.aliyuncs.com (the default in pipeline/config.py).
# Do NOT use a Token Plan key (sk-sp-...) here; those only work with the token-plan endpoint.
DASHSCOPE_API_KEY=sk-your-key-here

# Optional: path to the Ren'Py SDK executable for auto-lint after assembly.
# Linux (Docker image sets this automatically): /opt/renpy-sdk/renpy.sh
# Windows example: C:\renpy-8.3.4-sdk\renpy.exe
#RENPY_EXE=

# Optional overrides
#I2V_MODEL=happyhorse-1.1-i2v
#LLM_MODEL=qwen3.7-max
